# AI 圆桌环境变量示例
# 复制为 .env 并填入你自己的凭证：cp .env.example .env
# 注意：.env 已被 .gitignore 排除，切勿提交到仓库

# ===== 飞书机器人（可选，不填则飞书入口不可用，桌面端/本地 HTTP 照常）=====
# 在飞书开放平台 https://open.feishu.cn 创建「企业自建应用」后获取：
#   - 开通机器人能力
#   - 添加权限：im:message（接收与发送单聊消息）
#   - 事件订阅选择「长连接」模式，订阅 im.message.receive_v1
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 会话白名单（可选）：逗号分隔的 chat_id，配置后仅这些会话可触发圆桌；
# 群消息无论是否在名单内，都必须 @机器人 才会触发。留空 = 不限制单聊来源。
# FEISHU_ALLOW_CHAT_IDS=oc_xxxxxxxx,oc_yyyyyyyy

# ===== 本地 HTTP 接口端口（可选，默认 8765）=====
# ROUNDTABLE_PORT=8765
